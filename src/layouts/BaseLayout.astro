---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative path of the share image. */
  image?: string;
  type?: 'website' | 'article';
  /** schema.org JSON-LD objects to embed. */
  jsonLd?: object | object[];
}
const {
  title = 'doon.today',
  description = 'A calendar of things happening in Dehradun.',
  image = '/og-default.png',
  type = 'website',
  jsonLd
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(`${href}/`)) ? 'page' : undefined);
// The header links. On phones they move into a menu, but Submit Event stays in the bar.
const links: { href: string; label: string; current: 'page' | undefined }[] = [
  { href: '/', label: 'Events', current: path === '/' || path.startsWith('/events') ? 'page' : undefined },
  { href: '/calendars', label: 'Calendars', current: current('/calendars') },
  { href: '/about', label: 'About', current: current('/about') }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/calendar" title="doon.today events" href="/calendar.ics" />
    <meta property="og:site_name" content="doon.today" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="doon.today: what's happening in Doon?" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {structured.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, "\\u003c")} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href="/">doon.today</a>
        <nav aria-label="Primary navigation">
          <span class="nav-links">{links.map((link) => <a aria-current={link.current} href={link.href}>{link.label}</a>)}</span>
          <a class="nav-submit" aria-current={current('/submit')} href="/submit/">Submit Event</a>
          <details class="nav-menu">
            <summary aria-label="Menu">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" /></svg>
            </summary>
            <div class="nav-menu-panel">{links.map((link) => <a aria-current={link.current} href={link.href}>{link.label}</a>)}</div>
          </details>
        </nav>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer class="shell footer">
      <p>Doon.today is a calendar of things happening in Dehradun.</p>
      <p>Source provenance is shown on each event. Data may change; verify with the original organizer before travelling.</p>
      <p><a href="/submit/">Submit an event</a> · <a href="https://github.com/srijan-kapoor/doon.today">Source code</a> · <a href="https://github.com/srijan-kapoor/doon.today/issues/new">Report a problem</a></p>
    </footer>
  </body>
</html>
