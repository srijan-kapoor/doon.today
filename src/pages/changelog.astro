---
import BaseLayout from '../layouts/BaseLayout.astro';
import entries from '../data/changelog.json';
import { changelogByMonth, dayLabel } from '../lib/changelog.mjs';
const months = changelogByMonth(entries);
---
<BaseLayout title="Changelog — doon.today" description="What has changed on doon.today, newest first.">
  <section class="simple-page prose">
    <p class="eyebrow">CHANGELOG</p>
    <h1>What's new.</h1>
    <p class="lede">Changes to doon.today, newest first. Something missing or not working? <a href="/feedback/" data-feedback>Tell us</a>.</p>
    {months.map((month) => (
      <section class="changelog-month">
        <h2>{month.label}</h2>
        <ul class="changelog-list">
          {month.entries.map((entry) => (
            <li>
              <time datetime={entry.date}>{dayLabel(entry.date)}</time>
              <span class="changelog-tag" data-tag={entry.tag}>{entry.tag}</span>
              <p>{entry.text}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
