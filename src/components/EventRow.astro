---
import type { EventRecord } from '../types/event';
import { toInstant, eventDayRange } from '../lib/dates.mjs';
import { priceLabel } from '../lib/sources.mjs';
const { event, today } = Astro.props as { event: EventRecord; today: string };
const range = eventDayRange(event);
const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(event.startAt);
const start = toInstant(event.startAt);
const time = dateOnly
  ? 'Time TBA'
  : new Intl.DateTimeFormat('en-IN', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' }).format(start);
const until = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const displayTime = !range.days && range.start < today && range.end >= today
  ? `Until ${until.format(new Date(`${range.end}T12:00:00+05:30`))}` : time;
const price = priceLabel(event.pricing, 'short');
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const showArea = event.venue.area && !event.venue.name.toLowerCase().includes(event.venue.area.toLowerCase());
---
<article
  class="event-row"
  data-categories={event.categories.map(slug).join(' ')}
  data-price={event.pricing.type}
  data-area={event.venue.area ? slug(event.venue.area) : ''}
  data-start-date={range.start}
  data-end-date={range.end}
  data-days={range.days?.join(' ')}
>
  <div class="event-time" data-start-time={time}>{displayTime}</div>
  <div class="event-main">
    <a class="event-title" href={`/events/${event.slug}/`}>{event.title}</a>
    <div class="event-meta">{event.venue.name}{showArea ? ` · ${event.venue.area}` : ''}</div>
    <div class="event-tags">
      {event.categories.map((category) => <span>{category}</span>)}
      {event.verificationStatus === 'review' && <span class="community">Source reported</span>}
      {event.verificationStatus === 'community-reported' && <span class="community">Community reported</span>}
    </div>
  </div>
  <div class="event-price">{price}</div>
</article>
