---
// The feedback form. BaseLayout puts it in a dialog on every page; /feedback/ shows it on its own for
// browsers without JavaScript. Netlify Forms reads it at build time by its name.
interface Props { dialog?: boolean }
const { dialog = false } = Astro.props;
---
<form class="submit-form feedback-form" name="feedback" method="POST" action="/feedback/thanks/" data-netlify="true" netlify-honeypot="bot-field" data-feedback-form>
  <input type="hidden" name="form-name" value="feedback" />
  <input type="hidden" name="page" value="" />
  <input type="hidden" name="about" value="" />
  <p class="trap" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  <p class="feedback-about" data-feedback-about hidden></p>
  <fieldset class="feedback-vote" data-feedback-vote>
    <legend>Do you like doon.today?</legend>
    <div class="choices">
      <label><input type="radio" name="vote" value="like" /> <span>👍&nbsp; I like it</span></label>
      <label><input type="radio" name="vote" value="dislike" /> <span>👎&nbsp; Not really</span></label>
    </div>
  </fieldset>
  <label><span data-feedback-prompt>What's wrong, or what could be better?</span> <textarea name="message" rows="4" maxlength="2000"></textarea></label>
  <label><span>Email <span class="optional">optional, only if you'd like a reply</span></span> <input type="email" name="email" autocomplete="email" maxlength="200" /></label>
  <p class="feedback-status" role="status" data-feedback-status></p>
  <div class="feedback-actions">
    <button type="submit">Send</button>
    {dialog && <button type="button" class="link-button" data-feedback-close>Cancel</button>}
  </div>
</form>
