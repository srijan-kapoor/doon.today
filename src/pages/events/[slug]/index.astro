---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { events, pastEvents } from '../../../data/events';
import { ingestStatus } from '../../../data/status';
import { googleDateRange, toInstant } from '../../../lib/ics.mjs';
import { occurrencesOf, istTime } from '../../../lib/dates.mjs';
import { eventJsonLd, eventPageTitle, eventSummary } from '../../../lib/seo.mjs';
import { cardWhen } from '../../../lib/og.mjs';
import { sourceLabel, detailsLinkLabel, priceLabel } from '../../../lib/sources.mjs';
import { eventAbout } from '../../../lib/feedback.mjs';
import { descriptionParagraphs } from '../../../lib/details.mjs';

export function getStaticPaths() {
  const listed = events.filter(e => e.curation.status === 'published');
  // An ended event keeps its page, so links to it don't break; it points to what's on next.
  const next = (event: (typeof pastEvents)[number]) => {
    const shared = listed.filter((e) => e.categories.some((c) => event.categories.includes(c)));
    return (shared.length ? shared : listed).slice(0, 3);
  };
  return [
    ...listed.map((event) => ({ params: { slug: event.slug }, props: { event, ended: false, upcoming: [] } })),
    ...pastEvents.map((event) => ({ params: { slug: event.slug }, props: { event, ended: true, upcoming: next(event) } }))
  ];
}

const { event, ended, upcoming } = Astro.props;
const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(event.startAt);
const start = toInstant(event.startAt);
const date = new Intl.DateTimeFormat('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }).format(
  dateOnly ? new Date(`${event.startAt}T12:00:00+05:30`) : start
);
const time = dateOnly
  ? 'Time to be announced'
  : istTime.format(start);
// An event on specific dates lists each session instead of one date.
const sessions = occurrencesOf(event);
const sessionFormat = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', ...(dateOnly ? {} : { hour: 'numeric', minute: '2-digit', hour12: true }), timeZone: 'Asia/Kolkata' });
const sessionLabels = sessions?.map((value) => sessionFormat.format(dateOnly ? new Date(`${value}T12:00:00+05:30`) : toInstant(value)));
const checked = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });

const address = event.venue.address?.trim();
const location = [event.venue.name, event.venue.address, event.venue.area, 'Dehradun'].filter(Boolean).join(', ');
const pageUrl = new URL(`/events/${event.slug}/`, Astro.site).href;
const imageUrl = new URL(ended ? '/og-default.png' : `/events/${event.slug}/og.png`, Astro.site).href;
const summary = eventSummary(event);

const googleParams = new URLSearchParams({
  action: 'TEMPLATE',
  text: event.title,
  dates: googleDateRange(event),
  details: event.description || `More details: ${pageUrl}`,
  location
});
const googleCalendarUrl = `https://calendar.google.com/calendar/render?${googleParams.toString()}`;
const sourceUnavailable = event.sources?.some((source) => ingestStatus.sources?.[source.provider]?.status === 'failed');
const primarySource = event.sources?.[0];
const detailsLabel = detailsLinkLabel(primarySource);
---
<BaseLayout
  title={eventPageTitle(event.title)}
  description={summary}
  image={imageUrl}
  imageAlt={ended ? undefined : `${event.title}: ${cardWhen(event)}, ${event.venue.name}`}
  type="article"
  jsonLd={ended ? undefined : eventJsonLd(event, { pageUrl, imageUrl })}
  noindex={ended}
>
  <article class="detail">
    <a class="back" href="/">← Events</a>
    <p class="eyebrow">{event.categories.join(' · ')}</p>
    <h1>{event.title}</h1>
    {ended && (
      <div class="notice event-ended">
        <p><strong>This event has ended.</strong> <a href="/">See what's on in Dehradun</a></p>
        {upcoming.length > 0 && <ul>{upcoming.map((e) => <li><a href={`/events/${e.slug}/`}>{e.title}</a></li>)}</ul>}
      </div>
    )}
    <dl>
      <div><dt>When</dt><dd>{sessionLabels ? sessionLabels.map((label, i) => <>{i > 0 ? <br /> : null}{label}</>) : <>{date}<br />{time}</>}</dd></div>
      <div><dt>Where</dt><dd>{event.venue.name}{address ? <><br />{address}</> : null}{event.venue.area && !`${event.venue.name} ${address ?? ''}`.toLowerCase().includes(event.venue.area.toLowerCase()) ? <><br />{event.venue.area}</> : null}</dd></div>
      {event.organizer && <div><dt>Organizer</dt><dd>{event.organizer}</dd></div>}
      {event.howToJoin && <div><dt>How to join</dt><dd>{event.howToJoin}</dd></div>}
      <div><dt>Price</dt><dd>{priceLabel(event.pricing) || (detailsLabel && primarySource?.url ? <>Not listed. <a href={primarySource.url} target="_blank" rel="noreferrer">{detailsLabel}</a></> : 'Not listed.')}</dd></div>
    </dl>

    {event.description && <div class="event-description">{descriptionParagraphs(event.description).map((paragraph) => <p>{paragraph}</p>)}</div>}

    {!ended && <div class="event-actions" style="display:flex;flex-wrap:wrap;gap:.75rem;margin:1.5rem 0 2rem">
      <a class="primary-link" href={`/events/${event.slug}.ics`}>Add to calendar</a>
      <a class="primary-link" href={googleCalendarUrl} target="_blank" rel="noreferrer">Google Calendar ↗</a>
      {detailsLabel && <a class="primary-link" href={primarySource.url} target="_blank" rel="noreferrer">{detailsLabel} ↗</a>}
    </div>}

    <div class="source-block">
      <h2>Where this comes from</h2>
      {event.sources.map((source) => source.provider === 'manual'
        ? <p>Checked by hand on {checked.format(new Date(source.checkedAt))}</p>
        : <p>From <a href={source.url} target="_blank" rel="noreferrer">{sourceLabel(source.provider)}</a>, last checked {checked.format(new Date(source.checkedAt))}</p>)}
      {sourceUnavailable && <p class="notice">This source was unavailable during the latest data refresh. These details were last checked {checked.format(new Date(event.lastCheckedAt))}; confirm them with the source before travelling.</p>}
      {event.verificationStatus === 'review' && <p class="notice">Taken from a listing site and not checked by hand yet. Check with the organizer before you go.</p>}
      {event.verificationStatus === 'community-reported' && <p class="notice">Sent in by a visitor rather than the organizer. Check with the organizer before you go.</p>}
      <p class="report"><a href="/feedback/" data-feedback data-about={eventAbout(event)} data-about-label={event.title}>Report a problem with this event</a></p>
    </div>
  </article>
</BaseLayout>
