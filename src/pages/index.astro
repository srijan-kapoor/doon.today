---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventRow from '../components/EventRow.astro';
import { events } from '../data/events';
import { ingestStatus, staleSources } from '../data/status';
import { istDay, compareEventStarts, eventDisplayDay } from '../lib/dates.mjs';

const today = istDay(new Date().toISOString());
const published = events
  .filter((event) => event.curation.status === 'published')
  .filter((event) => eventDisplayDay(event, today) !== null)
  .sort(compareEventStarts);
const grouped = Map.groupBy(published, (event) => eventDisplayDay(event, today)!);
const dateFmt = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const refreshedAt = Date.parse(ingestStatus.ranAt);
const stale = staleSources();
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const tally = (values: string[]) => [...values.reduce((m, v) => m.set(v, (m.get(v) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const categoryOptions = tally(published.flatMap((e) => e.categories));
const areaOptions = tally(published.flatMap((e) => (e.venue.area ? [e.venue.area] : [])));
const hasFree = published.some((e) => e.pricing.type === 'free');
const showHealthBanner = ingestStatus.health === 'degraded';
// Identifies which sources the banner is about, so a dismissal only lasts until that set changes.
const healthKey = stale.length > 0 ? stale.map((s) => s.name).sort().join(',') : 'degraded';
const staleNames = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' }).format(stale.map((s) => s.label));
const lastUpdated = stale.filter((s) => s.lastSuccess !== 'not recorded yet').map((s) => `${s.label} last updated ${s.lastSuccess}.`).join(' ');
const healthMessage = stale.length > 0
  ? `${staleNames} ${stale.length === 1 ? "isn't" : "aren't"} updating right now. Showing the latest saved events from other sources. ${lastUpdated}`.trim()
  : 'Some sources are not updating right now. Showing the latest saved events.';
---
<BaseLayout
  title="doon.today — What's happening in Dehradun"
  description="A calendar of events in Dehradun: concerts, comedy, festivals, runs and more, with the source and freshness of every listing."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'doon.today', url: 'https://doon.today/' }}
>
  <section class="hero">
    <p class="eyebrow">DEHRADUN · UTTARAKHAND</p>
    <h1>What’s happening<br />in Doon?</h1>
    <p class="lede">A quiet, useful calendar of events worth knowing about.</p>
    <div class="filters" id="when-filters" role="group" aria-label="Event date filters">
      <button class="active" aria-pressed="true" data-filter="all">Upcoming</button>
      <button aria-pressed="false" data-filter="today">Today</button>
      <button aria-pressed="false" data-filter="tomorrow">Tomorrow</button>
      <button aria-pressed="false" data-filter="weekend">Weekend</button>
    </div>
    <div class="filters" role="group" aria-label="Category filters">
      <button class="active" aria-pressed="true" data-category="">All categories</button>
      {categoryOptions.map(([name, count]) => <button aria-pressed="false" data-category={slug(name)}>{name} <span class="filter-count">{count}</span></button>)}
    </div>
    <div class="filters" role="group" aria-label="Price and area filters">
      {hasFree && <button aria-pressed="false" data-price="free">Free only</button>}
      {areaOptions.length > 0 && (
        <label class="filter-select">Area
          <select id="area-filter">
            <option value="">Anywhere in Dehradun</option>
            {areaOptions.map(([name, count]) => <option value={slug(name)} data-name={name}>{name} ({count})</option>)}
          </select>
        </label>
      )}
    </div>
  </section>

  <section class="curated">
    <div class="section-heading">
      <h2>Events</h2><span id="event-count">{published.length}</span>
      <div class="view-switch" role="group" aria-label="Event view">
        <button type="button" class="active" aria-pressed="true" data-view="list">List</button>
        <button type="button" aria-pressed="false" data-view="month">Month</button>
      </div>
      {Number.isFinite(refreshedAt) && <small>Data refreshed {new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'short',hour:'numeric',minute:'2-digit',timeZone:'Asia/Kolkata'}).format(refreshedAt)}</small>}
    </div>
    {showHealthBanner && (
      <div class="source-health" id="source-health" role="status" data-sources={healthKey}>
        <p>{healthMessage}</p>
        <button type="button" class="source-health-dismiss" id="source-health-dismiss" aria-label="Dismiss">×</button>
      </div>
      <script is:inline>
        // Runs right after the banner is parsed, so a dismissed banner never flashes. The choice is kept
        // per browser and only holds while the same sources are affected; storage may be unavailable.
        (function () {
          var banner = document.getElementById('source-health');
          if (!banner) return;
          var key = 'doon.sourceHealthDismissed';
          var current = banner.getAttribute('data-sources');
          try { if (localStorage.getItem(key) === current) banner.hidden = true; } catch (e) {}
          document.getElementById('source-health-dismiss').addEventListener('click', function () {
            banner.hidden = true;
            try { localStorage.setItem(key, current); } catch (e) {}
          });
        })();
      </script>
    )}
    <div id="empty-state" class="empty-state" hidden>No events found for this view yet.</div>
    <div id="month-view" class="month-view">
      <div id="date-strip" class="date-strip" role="group" aria-label="Pick a day"></div>
      <div id="month-grid" class="month-grid">
        <div class="month-nav">
          <button type="button" id="month-prev" aria-label="Previous month">‹</button>
          <strong id="month-title" aria-live="polite"></strong>
          <button type="button" id="month-next" aria-label="Next month">›</button>
        </div>
        <div id="month-days" class="month-days" role="group" aria-label="Pick a day"></div>
      </div>
      <p class="month-legend"><i class="dot"></i> More dots, busier day</p>
      <h3 id="month-day-heading" class="month-day-heading" tabindex="-1"></h3>
      <div id="month-day-list"></div>
      <p id="month-empty" class="month-empty" hidden>Nothing listed for this day yet. Know of something? <a class="primary-link" href="/submit/">Submit an event</a>.</p>
    </div>
    {[...grouped.entries()].map(([day, dayEvents]) => (
      <section class="day-group" data-date={day}>
        <h3>{dateFmt.format(new Date(`${day}T12:00:00+05:30`))}</h3>
        {dayEvents.map((event) => <EventRow event={event} today={today} />)}
      </section>
    ))}
  </section>

  <script is:inline>
    // Set before paint so a shared ?view=month link never flashes the list first.
    if (/[?&]view=month/.test(location.search)) document.documentElement.classList.add('view-month');
  </script>
  <script is:inline>
    const parts = new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata',year:'numeric',month:'2-digit',day:'2-digit',weekday:'short'}).formatToParts(new Date());
    const val=(type)=>parts.find(p=>p.type===type)?.value;
    const today=`${val('year')}-${val('month')}-${val('day')}`;
    const add=(iso,n)=>{const d=new Date(`${iso}T12:00:00+05:30`);d.setUTCDate(d.getUTCDate()+n);return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata',year:'numeric',month:'2-digit',day:'2-digit'}).format(d)};
    const tomorrow=add(today,1);
    const weekday=new Date(`${today}T12:00:00+05:30`).getUTCDay();
    const untilSat=weekday===0?-1:(6-weekday+7)%7; const sat=add(today,untilSat); const sun=add(sat,1);
    const empty=document.querySelector('#empty-state');
    const count=document.querySelector('#event-count'); const areaSelect=document.querySelector('#area-filter');
    const whenValues=['all','today','tomorrow','weekend'];
    const categoryValues=[...document.querySelectorAll('[data-category]')].map(b=>b.dataset.category);

    // The selection lives in the URL (?when=weekend&category=music&price=free&area=rajpur) so a filtered view can be shared.
    const params=new URLSearchParams(location.search);
    const state={
      when: whenValues.includes(params.get('when')) ? params.get('when') : 'all',
      category: categoryValues.includes(params.get('category')) ? params.get('category') : '',
      price: params.get('price')==='free' ? 'free' : '',
      area: areaSelect && [...areaSelect.options].some(o=>o.value===params.get('area')) ? params.get('area') : ''
    };

    // Month view replaces the date filters, so they must not skew the category and area counts there.
    const dayOk=(row)=>{
      const {startDate:start,endDate:end,days}=row.dataset;
      if(end<today) return false;
      if(document.documentElement.classList.contains('view-month')) return true;
      // An event on specific dates is only on those days, not on every day between its first and last.
      if(days){
        const on=days.split(' ');
        return state.when==='all'
          || (state.when==='today'&&on.includes(today))
          || (state.when==='tomorrow'&&on.includes(tomorrow))
          || (state.when==='weekend'&&(on.includes(sat)||on.includes(sun)));
      }
      return state.when==='all'
        || (state.when==='today'&&start<=today&&end>=today)
        || (state.when==='tomorrow'&&start<=tomorrow&&end>=tomorrow)
        || (state.when==='weekend'&&start<=sun&&end>=sat);
    };
    // A row matches every active filter except the one named in `ignore`, so each filter's counts reflect the others.
    const matches=(row,ignore)=>dayOk(row)
      && (ignore==='category' || !state.category || row.dataset.categories.split(' ').includes(state.category))
      && (ignore==='price' || !state.price || row.dataset.price===state.price)
      && (ignore==='area' || !state.area || row.dataset.area===state.area);
    const rows=[...document.querySelectorAll('.event-row')];
    // A static build can be days old. Regroup using the reader's current IST day on every load.
    const byDay=new Map();
    const headingDate=new Intl.DateTimeFormat('en-IN',{weekday:'short',day:'numeric',month:'short',timeZone:'Asia/Kolkata'});
    const untilDate=new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'short',timeZone:'Asia/Kolkata'});
    rows.forEach(row=>{
      const start=row.dataset.startDate, end=row.dataset.endDate;
      const days=row.dataset.days&&row.dataset.days.split(' ');
      const day=days?days.find(d=>d>=today):(end<today?undefined:start<today?today:start);
      if(!day) {row.remove();return;}
      if(!byDay.has(day)){
        const group=document.createElement('section');group.className='day-group';group.dataset.date=day;
        const heading=document.createElement('h3');heading.textContent=headingDate.format(new Date(`${day}T12:00:00+05:30`));
        group.append(heading);byDay.set(day,group);
      }
      const time=row.querySelector('.event-time');
      time.textContent=!days&&start<today?`Until ${untilDate.format(new Date(`${end}T12:00:00+05:30`))}`:time.dataset.startTime;
      byDay.get(day).append(row);
    });
    document.querySelectorAll('.day-group').forEach(group=>group.remove());
    const groups=[...byDay.values()].sort((a,b)=>a.dataset.date.localeCompare(b.dataset.date));
    groups.forEach(group=>document.querySelector('.curated').append(group));
    // Event rows also carry data-price; only buttons should control the price filter.
    const priceButtons=[...document.querySelectorAll('button[data-price]')];

    function apply(){
      let shown=0;
      groups.forEach(g=>{
        let visible=0;
        g.querySelectorAll('.event-row').forEach(row=>{
          const ok=matches(row);
          row.hidden=!ok; if(ok) visible++;
        });
        g.hidden=visible===0; shown+=visible;
      });
      empty.hidden=shown!==0;
      if(count) count.textContent=String(shown);
      document.querySelectorAll('[data-category]:not([data-category=""])').forEach(b=>{
        const n=rows.filter(r=>matches(r,'category')&&r.dataset.categories.split(' ').includes(b.dataset.category)).length;
        b.querySelector('.filter-count').textContent=String(n); b.classList.toggle('empty',n===0);
      });
      if(areaSelect) [...areaSelect.options].forEach(o=>{
        if(!o.value) return;
        o.textContent=`${o.dataset.name} (${rows.filter(r=>matches(r,'area')&&r.dataset.area===o.value).length})`;
      });
      const mark=(btn,on)=>{btn.classList.toggle('active',on);btn.setAttribute('aria-pressed',String(on));};
      document.querySelectorAll('[data-filter]').forEach(b=>mark(b,b.dataset.filter===state.when));
      document.querySelectorAll('[data-category]').forEach(b=>mark(b,b.dataset.category===state.category));
      priceButtons.forEach(b=>mark(b,b.dataset.price===state.price));
      if(areaSelect) areaSelect.value=state.area;
      const next=new URLSearchParams();
      if(state.when!=='all') next.set('when',state.when);
      if(state.category) next.set('category',state.category);
      if(state.price) next.set('price',state.price);
      if(state.area) next.set('area',state.area);
      // The Month view owns view= and date=; keep whatever it last wrote.
      const month=new URLSearchParams(location.search);
      if(month.get('view')) next.set('view',month.get('view'));
      if(month.get('date')) next.set('date',month.get('date'));
      const query=next.toString();
      try{history.replaceState(null,'',location.pathname+(query?'?'+query:'')+location.hash);}catch(e){}
      if(typeof Event==='function'&&document.dispatchEvent) document.dispatchEvent(new Event('doon:filters'));
    }

    document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{state.when=b.dataset.filter;apply();}));
    document.querySelectorAll('[data-category]').forEach(b=>b.addEventListener('click',()=>{state.category=b.dataset.category;apply();}));
    priceButtons.forEach(b=>b.addEventListener('click',()=>{state.price=state.price===b.dataset.price?'':b.dataset.price;apply();}));
    if(areaSelect) areaSelect.addEventListener('change',()=>{state.area=areaSelect.value;apply();});
    apply();
    // Lets the Month view (the module script below) read the same filters and react when they change.
    globalThis.doonFilters={state,today,apply};
  </script>
  <script>
    import './../scripts/month-view.mjs';
  </script>
</BaseLayout>
