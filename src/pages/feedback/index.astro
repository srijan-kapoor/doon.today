---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedbackForm from '../../components/FeedbackForm.astro';
---
<BaseLayout title="Feedback — doon.today" description="Tell us what's wrong on doon.today, or what could be better.">
  <section class="simple-page">
    <p class="eyebrow">FEEDBACK</p>
    <h1>Tell us how it's going.</h1>
    <p class="lede">Something wrong, missing or confusing? Every message is read. Nothing you send here is made public.</p>
    <FeedbackForm />
  </section>
</BaseLayout>
